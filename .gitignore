# --- Laravel / PHP ---------------------------------------------------------
*.log
*.log.*
/vendor
/.phpunit.cache
/.phpunit.result.cache
/.phpactor.json
/auth.json
Homestead.json
Homestead.yaml
Thumbs.db
.DS_Store

# --- Environment (NEVER commit real values) ---------------------------------
.env
.env.*
!.env.example

# .env.testing is tracked on purpose: CI needs a known test database
# config. It only ever contains local/container credentials.
!.env.testing

# --- Node / frontend build -------------------------------------------------
/node_modules
/public/build
/public/hot
npm-debug.log*
yarn-error.log*

# --- Storage: keys, logs, sessions, cache, compiled views -------------------
/storage/*.key
/storage/pail
/storage/logs/*
!/storage/logs/.gitignore
/storage/framework/cache/data/*
/storage/framework/sessions/*
/storage/framework/views/*
/storage/framework/testing/*
/storage/framework/.gitignore

# --- Private / user-uploaded data -------------------------------------------
# Student documents and photos must never enter version control.
/public/storage
/public/uploads
/storage/app/private
/storage/app/uploads
/storage/app/public/uploads
*.sql
*.sql.gz
*.dump
/database/backups

# --- IDE / OS ---------------------------------------------------------------
/.idea
/.nova
/.fleet
/.vscode
/.zed
/.fleet

# One-off local verification/scratch scripts (not part of the app)
hermes-*
sync-vendor.sh

# --- Documentation tooling --------------------------------------------
__pycache__/
*.pyc
docs/diagrams/*.tmp.pptx

# --- Vercel ----------------------------------------------------------------
.vercel
.env*

# `dist/` is produced by the Vercel build command (a copy of public/build) and
# is regenerated on every deploy. Committing it would only bloat the
# repository; public/build is the real source and it is already ignored.
dist/

# A stray `curl ... > -w` (dash-w instead of -w with an argument) lands an HTML
# error page in the repository root under the name `-w`, and git happily stages
# it because the name is not obviously junk. Two of these were created and
# removed during the Vercel work; ignore the pattern so the third cannot happen.
/-w
/-o
/-s
