###############################################################################
# SIDA — Sistem Informasi Data Siswa
# Environment template. Contains NO secrets; copy to .env and fill in locally.
#
#   cp .env.example .env
#
# On managed hosts (e.g. Wasmer) most of these are set in the dashboard
# instead. See docs/DEPLOY-WASMER.md.
###############################################################################

# ----------------------------------------------------------------------------
# Application
# ----------------------------------------------------------------------------
APP_NAME="Sistem Informasi Data Siswa"
APP_ENV=local
# Generate with: php artisan key:generate
# NEVER commit a production key — regenerating it invalidates cookies,
# encrypted values and every open session.
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=Asia/Jakarta

# REQUIRED IN PRODUCTION. Set it to the real https origin of the deployment,
# e.g. APP_URL=https://app-sekolah.sch.id
#
# It is used for absolute links in emails (password reset, verification) and as
# the fallback for console/queue contexts where there is no live request.
# It is NOT forced over the live request host, so a forgotten value cannot make
# the running application emit localhost links to visitors.
APP_URL=http://localhost:8000

# Absolute base for generated storage URLs (documents, branding). Leave empty
# unless files are served from a separate host or CDN; relative /storage is
# correct in every other case.
ASSET_URL=

APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

# ----------------------------------------------------------------------------
# Logging
# stderr is the right choice for containers and edge platforms, where the
# filesystem may be ephemeral and only stdout/stderr is collected.
# ----------------------------------------------------------------------------
LOG_CHANNEL=stderr
LOG_LEVEL=debug

# ----------------------------------------------------------------------------
# Database
#
# Docker/standard Laravel: set DB_DATABASE.
# Wasmer injects DB_NAME instead; config/database.php falls back to it, so
# DB_DATABASE may be left blank there.
# ----------------------------------------------------------------------------
# DB_CONNECTION must be set explicitly in production. The application defaults
# to mysql (NOT sqlite), but leaving it unset is what previously let a managed
# host silently fall through to a sqlite file that does not exist.
DB_CONNECTION=mysql

# Docker Compose (local): the service is named "mysql".
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=siswa_data
DB_USERNAME=siswa
DB_PASSWORD=

# Wasmer (production): Wasmer injects DB_HOST / DB_PORT / DB_NAME /
# DB_USERNAME / DB_PASSWORD itself. Do NOT copy them into .env. Note it supplies
# DB_NAME, not DB_DATABASE — config/database.php falls back from DB_DATABASE to
# DB_NAME, so the app connects without any manual duplication. If you ever set
# DB_DATABASE in Wasmer it takes precedence, which is also correct.

# ----------------------------------------------------------------------------
# Session & cache
#
# file drivers break on ephemeral or multi-instance filesystems. Use the
# database driver in production (the sessions/cache tables ship with Laravel).
# ----------------------------------------------------------------------------
# Production (Wasmer) MUST use the database driver. A file driver is unsafe on
# an ephemeral or multi-instance filesystem, and the sessions table ships with
# Laravel's own migration. Local Docker may keep `file` for speed.
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# Set true when serving over HTTPS behind a trusted proxy.
SESSION_SECURE_COOKIE=
SESSION_SAME_SITE=lax

# Database cache in production: the failure this replaces was a DatabaseStore
# cache read failing because the driver was sqlite. The cache/cache_locks
# tables ship with Laravel's own migration.
CACHE_STORE=database
CACHE_PREFIX=

BROADCAST_CONNECTION=log

# ----------------------------------------------------------------------------
# Queue
#
# The application dispatches no background jobs, so sync is correct and avoids
# configuring a worker that would never run.
# ----------------------------------------------------------------------------
QUEUE_CONNECTION=sync

# ----------------------------------------------------------------------------
# Filesystem
#
# `public` is what the local Docker setup uses. Student documents are served
# only through the authorised /berkas routes — never as public assets.
# For an ephemeral production filesystem, point this at object storage and
# set FILESYSTEM_* accordingly (see docs/DEPLOY-WASMER.md).
# ----------------------------------------------------------------------------
FILESYSTEM_DISK=public

# Workspace Drive uses a separate PRIVATE disk; it never reuses the public media
# disk. For S3-compatible storage, set WORKSPACE_STORAGE_DRIVER=s3 and provide a
# dedicated bucket/endpoint/key so school files cannot inherit public bucket ACLs.
WORKSPACE_STORAGE_DRIVER=local
WORKSPACE_STORAGE_BUCKET=
WORKSPACE_STORAGE_PREFIX=lyfla-workspace
WORKSPACE_STORAGE_ENDPOINT=
WORKSPACE_STORAGE_REGION=us-east-1
WORKSPACE_STORAGE_ACCESS_KEY=
WORKSPACE_STORAGE_SECRET_KEY=
WORKSPACE_STORAGE_USE_PATH_STYLE_ENDPOINT=false
# Must not exceed PHP upload_max_filesize / post_max_size until chunked uploads exist.
WORKSPACE_MAX_FILE_KB=2048
# Per owner/school; all retained historical versions and Trash count (1 GiB).
WORKSPACE_QUOTA_BYTES=1073741824
# Private scanner endpoint; unset intentionally quarantines uploads.
WORKSPACE_CLAMD_HOST=
WORKSPACE_CLAMD_PORT=3310
WORKSPACE_CLAMD_UNIX_SOCKET=
WORKSPACE_SCAN_TIMEOUT_SECONDS=30
WORKSPACE_SCAN_MAX_BYTES=104857600
WORKSPACE_WOPI_TOKEN_TTL_MINUTES=120
WORKSPACE_WOPI_LOCK_TTL_MINUTES=30
WORKSPACE_WOPI_EXTENSIONS=doc,docx,odt,rtf,txt,xls,xlsx,ods,ppt,pptx,odp,csv
# The WOPI host URL must be reachable from the Collabora container (local Docker default).
WORKSPACE_WOPI_HOST_URL=http://host.docker.internal:8000
COLLABORA_INTERNAL_URL=http://collabora:9980
# Browser-facing Collabora origin; use HTTPS outside local development.
COLLABORA_PUBLIC_URL=http://localhost:9980

# ----------------------------------------------------------------------------
# Proxy / HTTPS
#
# Set behind a load balancer or edge platform that terminates TLS. Use a
# comma-separated CIDR list, or * when the app is only reachable via that proxy.
# ----------------------------------------------------------------------------
TRUSTED_PROXIES=*

# ----------------------------------------------------------------------------
# Mail
# ----------------------------------------------------------------------------
MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="no-reply@example.test"
MAIL_FROM_NAME="${APP_NAME}"

# ----------------------------------------------------------------------------
# Vite
# ----------------------------------------------------------------------------
VITE_APP_NAME="${APP_NAME}"

# ----------------------------------------------------------------------------
# LYFLA AI School Assistant
#
# The API key is server-side only. Never place it in Blade, JavaScript, or git.
# The key supplied in a chat prompt is treated as compromised; create a fresh
# key in the provider dashboard before enabling real requests.
# ----------------------------------------------------------------------------
AI_PROVIDER=agentrouter
AGENTROUTER_BASE_URL=https://agentrouter.org/v1
AGENTROUTER_MODEL=glm-5.3
AGENTROUTER_API_KEY=
AGENTROUTER_TEMPERATURE=0.2
AGENTROUTER_MAX_TOKENS=700
AGENTROUTER_CONNECT_TIMEOUT=8
AGENTROUTER_TIMEOUT=35
AGENTROUTER_CA_BUNDLE=

# Legacy rollback provider (optional)
NARAROUTER_BASE_URL=https://router.bynara.id/v1
NARAROUTER_MODEL=agnes-2.5-flash
NARAROUTER_API_KEY=
NARAROUTER_TEMPERATURE=0.2
NARAROUTER_MAX_TOKENS=700
NARAROUTER_CONNECT_TIMEOUT=8
NARAROUTER_TIMEOUT=35
NARAROUTER_CA_BUNDLE=
