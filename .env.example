###############################################################################
# SIDA — Sistem Informasi Data Siswa
# Environment template. Contains NO secrets; copy to .env and fill in locally.
#
#   cp .env.example .env
#
# On managed hosts (e.g. Wasmer) most of these are set in the dashboard
# instead. See docs/DEPLOY-WASMER.md.
###############################################################################

# ----------------------------------------------------------------------------
# Application
# ----------------------------------------------------------------------------
APP_NAME="Sistem Informasi Data Siswa"
APP_ENV=local
# Generate with: php artisan key:generate
# NEVER commit a production key — regenerating it invalidates cookies,
# encrypted values and every open session.
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=Asia/Jakarta
APP_URL=http://localhost:8000

APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

# ----------------------------------------------------------------------------
# Logging
# stderr is the right choice for containers and edge platforms, where the
# filesystem may be ephemeral and only stdout/stderr is collected.
# ----------------------------------------------------------------------------
LOG_CHANNEL=stderr
LOG_LEVEL=debug

# ----------------------------------------------------------------------------
# Database
#
# Docker/standard Laravel: set DB_DATABASE.
# Wasmer injects DB_NAME instead; config/database.php falls back to it, so
# DB_DATABASE may be left blank there.
# ----------------------------------------------------------------------------
# DB_CONNECTION must be set explicitly in production. The application defaults
# to mysql (NOT sqlite), but leaving it unset is what previously let a managed
# host silently fall through to a sqlite file that does not exist.
DB_CONNECTION=mysql

# Docker Compose (local): the service is named "mysql".
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=siswa_data
DB_USERNAME=siswa
DB_PASSWORD=

# Wasmer (production): Wasmer injects DB_HOST / DB_PORT / DB_NAME /
# DB_USERNAME / DB_PASSWORD itself. Do NOT copy them into .env. Note it supplies
# DB_NAME, not DB_DATABASE — config/database.php falls back from DB_DATABASE to
# DB_NAME, so the app connects without any manual duplication. If you ever set
# DB_DATABASE in Wasmer it takes precedence, which is also correct.

# ----------------------------------------------------------------------------
# Session & cache
#
# file drivers break on ephemeral or multi-instance filesystems. Use the
# database driver in production (the sessions/cache tables ship with Laravel).
# ----------------------------------------------------------------------------
# Production (Wasmer) MUST use the database driver. A file driver is unsafe on
# an ephemeral or multi-instance filesystem, and the sessions table ships with
# Laravel's own migration. Local Docker may keep `file` for speed.
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# Set true when serving over HTTPS behind a trusted proxy.
SESSION_SECURE_COOKIE=
SESSION_SAME_SITE=lax

# Database cache in production: the failure this replaces was a DatabaseStore
# cache read failing because the driver was sqlite. The cache/cache_locks
# tables ship with Laravel's own migration.
CACHE_STORE=database
CACHE_PREFIX=

BROADCAST_CONNECTION=log

# ----------------------------------------------------------------------------
# Queue
#
# The application dispatches no background jobs, so sync is correct and avoids
# configuring a worker that would never run.
# ----------------------------------------------------------------------------
QUEUE_CONNECTION=sync

# ----------------------------------------------------------------------------
# Filesystem
#
# `public` is what the local Docker setup uses. Student documents are served
# only through the authorised /berkas routes — never as public assets.
# For an ephemeral production filesystem, point this at object storage and
# set FILESYSTEM_* accordingly (see docs/DEPLOY-WASMER.md).
# ----------------------------------------------------------------------------
FILESYSTEM_DISK=public

# ----------------------------------------------------------------------------
# Proxy / HTTPS
#
# Set behind a load balancer or edge platform that terminates TLS. Use a
# comma-separated CIDR list, or * when the app is only reachable via that proxy.
# ----------------------------------------------------------------------------
TRUSTED_PROXIES=*

# ----------------------------------------------------------------------------
# Mail
# ----------------------------------------------------------------------------
MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="no-reply@example.test"
MAIL_FROM_NAME="${APP_NAME}"

# ----------------------------------------------------------------------------
# Vite
# ----------------------------------------------------------------------------
VITE_APP_NAME="${APP_NAME}"
